# Copy to .env (never commit .env)
POSTGRES_PASSWORD=game_dev_password
DATABASE_URL=postgres://game:game_dev_password@127.0.0.1:5432/game
TEST_DATABASE_URL=postgres://game:game_dev_password@127.0.0.1:5432/game_test
NODE_ENV=development
PORT=3000
# Set to the web origin in production, e.g. https://game.example.com
ALLOWED_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=30
# Dev only: divides all activity durations (60 = 1 tick per second). Must be 1 in production.
TIME_SCALE=1
