{
  "name": "@game/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "migrate": "node --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "invite:create": "node --env-file-if-exists=../../.env src/scripts/create-invite.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@game/engine": "workspace:*",
    "@game/shared": "workspace:*",
    "@game/world": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
